# ── Required ──────────────────────────────────────────────────────────────────
# Groq API key (free tier at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# ── Windows: fixes Unicode encoding in terminal (REQUIRED on Windows)
PYTHONUTF8=1

# ── Optional overrides ────────────────────────────────────────────────────────
# LLM provider (default: groq)
LLM_PROVIDER=groq
# Model name (default: llama3-70b-8192)
LLM_MODEL=llama3-70b-8192

# ── NEVER commit your real .env file to version control ───────────────────────
